# Environment variables for HAMAR Backend
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas (or your local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hamar?retryWrites=true&w=majority

# ─── CORS ────────────────────────────────────────────────────────────────────
# The URL of your frontend dev server (Vite default is 5173)
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional approved frontend origins.
CORS_ORIGINS=http://localhost:5174,https://hamar-ui.vercel.app

# ─── Firebase Admin SDK ─────────────────────────────────────────────────────
# These values come from your Firebase project settings → Service Accounts → Generate new private key
# Download the JSON file, then copy the values below.
FIREBASE_PROJECT_ID=hamar-2effe
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@hamar-2effe.iam.gserviceaccount.com
# The private key contains newlines. When pasting into .env, keep the literal \n characters.
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADA...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
